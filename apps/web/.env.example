# Settings the website reads from its environment.
#   Development: copy this file to .env.local and fill it in (.env.local is never committed).
#   Live site (Hostinger): enter them in hPanel under the website's "Environment variables" (see docs/DEPLOY.md).

# The database. Development: the dev database on Hostinger, reached through Databases > Remote MySQL (the hostname is
# shown on that page); never point this at the live database while developing. Live site: the live database, with
# the host Hostinger shows for it (normally localhost).
DATABASE_URL="mysql://DEV_USER:DEV_PASSWORD@MYSQL_HOSTNAME:3306/DEV_DATABASE"

# Optional: how many connections the website keeps open (shared hosting allows only a few).
# DATABASE_POOL_SIZE=5

# Optional: where uploaded files (payment screenshots, organizer documents, event pictures) are kept, outside the
# public folder. Defaults: ./storage/uploads while developing, ~/sl-events-uploads (in the hosting account's home
# folder) on the live site. Never inside the website's build folder: Hostinger replaces it on every deployment.
# UPLOAD_DIR=/home/USER/sl-events-uploads

# Email (verification and password reset codes), sent from a mailbox made in hPanel > Emails. Without SMTP_HOST the
# messages are only written to the server log, which is fine for development.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=no-reply@example.com
# SMTP_PASS=the-mailbox-password
# MAIL_FROM="SL Events <no-reply@example.com>"

# Live site: the platform owner's email. Every deployment makes sure this account exists and is an admin (a new
# account has no password yet: use "Forgot password" on the website to set one). See scripts/deploy-db.mjs.
# ADMIN_EMAIL=owner@example.com

# Optional, live site only: addresses allowed to call the API from a browser (the mobile app's web preview), comma
# separated. The installed apps don't need this. In development every address is allowed.
# APP_ORIGINS=https://app-preview.example.com
