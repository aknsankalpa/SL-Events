# Copy this file to .env.local and fill it in. .env.local is never committed.

# The development database on Hostinger (Databases > Management), reached through Databases > Remote MySQL.
# The hostname is shown on the Remote MySQL page. Never point this at the live database while developing.
DATABASE_URL="mysql://DEV_USER:DEV_PASSWORD@MYSQL_HOSTNAME:3306/DEV_DATABASE"

# Optional: how many connections the website keeps open (shared hosting allows only a few).
# DATABASE_POOL_SIZE=5
